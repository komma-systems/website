{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "komma-slides",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/presentations.json"]
  },
  // Attaching this custom domain on deploy creates the proxied DNS record
  // and certificate when komma.systems is on the same Cloudflare account.
  "routes": [
    {
      "pattern": "slides.komma.systems",
      "custom_domain": true
    }
  ]
}
